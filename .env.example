# Copy this file to .env and fill in your values (see README)
GROQ_API_KEY=gsk_your_key_here

DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
ADMIN_PASSWORD=choose-a-strong-password

# Optional: email alert for each booking. Free key from https://resend.com/api-keys
# Sign up to Resend with the email below; without your own domain, Resend only sends to that address.
RESEND_API_KEY=re_your_key_here
NOTIFY_EMAIL=dev.shohanur@gmail.com

# VPS only (docker-compose.yml): the chatbot's web address and the Traefik network n8n created
DOMAIN=chat.srv1836598.hstgr.cloud
TRAEFIK_NETWORK=n8n_default
